<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <flow-layout direction="vertical">
                    <children>
                        <flow-layout direction="horizontal">
                            <children>
                                <item id="head-item">
                                    <margins>
                                        <right>2</right>
                                    </margins>
                                </item>
                                <label id="head-label" />
                            </children>

                            <vertical-alignment>center</vertical-alignment>

                            <margins>
                                <bottom>5</bottom>
                            </margins>
                        </flow-layout>

                        <flow-layout direction="vertical" id="fields">
                            <children />
                        </flow-layout>

                        <button id="confirm">
                            <text translate="true">screen.headbrowser.alert.confirm</text>

                            <sizing>
                                <horizontal method="fixed">40</horizontal>
                            </sizing>
                        </button>
                    </children>

                    <padding>
                        <all>10</all>
                    </padding>

                    <surface>
                        <panel dark="true"/>
                    </surface>

                    <vertical-alignment>center</vertical-alignment>
                    <horizontal-alignment>center</horizontal-alignment>

                </flow-layout>
            </children>

            <vertical-alignment>center</vertical-alignment>
            <horizontal-alignment>center</horizontal-alignment>

            <surface>
                <options-background />
            </surface>
        </flow-layout>
    </components>
</owo-ui>
